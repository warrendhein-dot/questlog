# Copy to `.env.local` for local development. `.env.local` is git-ignored: NEVER commit real secrets.
# This file documents variable NAMES and safe example values only. Keep it in sync with src/lib/env.ts.

# Public base URL of the app. Sign-in redirects are built from it. In production it is REQUIRED and
# must be https (the app refuses to work without it); locally it defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Dashboard > Settings > API Keys). Both values are safe to expose to the browser
# because row-level security protects the data. NEVER put the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
